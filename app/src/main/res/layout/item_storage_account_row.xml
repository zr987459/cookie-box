<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <!-- 顶部轻量分割线 -->
    <View
        android:id="@+id/topDividerAccount"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="@color/divider" />

    <!-- 账号标题与信息行 (紧凑型) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_person" />

        <TextView
            android:id="@+id/tvAccountName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="主账号" />

        <TextView
            android:id="@+id/tvAccountCookiesBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_box"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="9sp"
            tools:text="6 项" />

        <TextView
            android:id="@+id/tvAccountTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="10sp"
            tools:text="10-15 09:45" />

        <ImageButton
            android:id="@+id/btnDeleteAccount"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="删除"
            android:padding="5dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <!-- 紧凑型快捷操作按钮栏 (高度仅 30dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLaunchAccount"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1.2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="6dp"
            android:text="进入网站"
            android:textColor="@color/on_primary"
            android:textSize="10sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_open_in_browser"
            app:iconSize="12dp"
            app:iconTint="@color/on_primary" />

        <Space
            android:layout_width="5dp"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyAccount"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="6dp"
            android:text="复制 Header"
            android:textSize="10sp"
            app:cornerRadius="8dp" />

        <Space
            android:layout_width="5dp"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailsAccount"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="0.8"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="6dp"
            android:text="详情"
            android:textSize="10sp"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
