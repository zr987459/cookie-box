<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <!-- 账号标题与信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_person" />

        <TextView
            android:id="@+id/tvAccountName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="主账号 (带大会员)" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAccountCookies"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/primary_container"
            app:chipStrokeWidth="0dp"
            tools:text="6 项" />

        <ImageButton
            android:id="@+id/btnDeleteAccount"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="删除此账号"
            android:padding="6dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <!-- 储存时间 -->
    <TextView
        android:id="@+id/tvAccountTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/on_surface_variant"
        android:textSize="10sp"
        tools:text="储存时间: 2026-10-15 09:45" />

    <!-- 快捷操作区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLaunchAccount"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.2"
            android:text="进入网站"
            android:textColor="@color/on_primary"
            android:textSize="11sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_open_in_browser"
            app:iconSize="13dp"
            app:iconTint="@color/on_primary" />

        <Space
            android:layout_width="6dp"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyAccount"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="复制 Header"
            android:textSize="11sp"
            app:cornerRadius="10dp" />

        <Space
            android:layout_width="6dp"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailsAccount"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="0.8"
            android:text="详情"
            android:textSize="11sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- 账号之间的底部分割线 -->
    <View
        android:id="@+id/dividerAccount"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/divider" />

</LinearLayout>
