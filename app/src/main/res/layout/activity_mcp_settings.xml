<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="AI 访问（MCP）"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- 总开关 -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchEnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="开启 AI 访问"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="已关闭，端口未监听"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <!-- 连接信息 -->
            <TextView
                style="@style/McpSectionTitle"
                android:text="连接地址" />

            <TextView
                android:id="@+id/tvEndpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <TextView
                style="@style/McpSectionTitle"
                android:text="访问令牌（Bearer Token）" />

            <TextView
                android:id="@+id/tvToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowToken"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="显示" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyToken"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="复制" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetToken"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="重置" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="复制 MCP 客户端配置" />

            <!-- 站点授权 -->
            <TextView
                style="@style/McpSectionTitle"
                android:text="站点授权" />

            <TextView
                android:id="@+id/tvGrantsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="管理站点授权" />

            <!-- 写操作确认 -->
            <TextView
                style="@style/McpSectionTitle"
                android:text="写操作确认" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="写操作指 POST、PUT、PATCH、DELETE 等会提交或修改内容的请求。需要确认时会弹窗或发通知，60 秒不处理视为拒绝。"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgConfirmMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbConfirmAlways"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="每次确认"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbConfirmTrusted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="信任的站点免确认（推荐）"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbConfirmNever"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="全部免确认"
                    android:textColor="?attr/colorOnSurface" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="「信任的站点免确认」下，确认框里可勾选「本次会话免确认」或「信任该站点」。信任的站点可在站点授权里取消。"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <!-- 调用记录 -->
            <TextView
                style="@style/McpSectionTitle"
                android:text="调用记录" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="只记录时间、工具、标签、站点、结果和耗时，不记录参数和返回内容。"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="查看调用记录" />

            <!-- 端口 -->
            <TextView
                style="@style/McpSectionTitle"
                android:text="端口" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="1024–65535"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="5"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavePort"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="保存" />
            </LinearLayout>

            <!-- 局域网 -->
            <TextView
                style="@style/McpSectionTitle"
                android:text="网络范围" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchLan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="允许局域网访问（默认关闭）"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="关闭时只接受本机 127.0.0.1 的连接。电脑上的 AI 客户端可用 USB 调试：adb forward tcp:端口 tcp:端口，再连 127.0.0.1。"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <!-- Origin 白名单 -->
            <TextView
                style="@style/McpSectionTitle"
                android:text="Origin 白名单" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="原生 MCP 客户端不带 Origin，无需填写。浏览器或 Electron 客户端（如 MCP Inspector）会带 Origin，需要逐行填写完整来源，例如 http://localhost:6274。"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etOrigins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="top|start"
                android:hint="每行一个，留空表示全部拒绝"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textUri|textNoSuggestions"
                android:minLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveOrigins"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="保存白名单" />

            <TextView
                style="@style/McpSectionTitle"
                android:text="说明" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开启后，持有令牌的 AI 客户端可以通过 MCP 协议使用你在曲奇盒里已登录的网站。AI 只能看到并使用你在「站点授权」里授权的身份与站点。当前版本提供 list_sessions、get_cookies 和 http_request；写操作按下方「写操作确认」设置处理。关闭开关或点按通知即可立即停止，端口不再监听。"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
