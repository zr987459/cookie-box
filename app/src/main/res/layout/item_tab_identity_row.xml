<?xml version="1.0" encoding="utf-8"?>
<!-- T-030：标签面板的一行 = 一个身份标签：颜色圆点 + 账号名 + 页面标题。左滑关闭，长按改账号名 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutTabRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="0dp">

    <View
        android:id="@+id/viewIdentityDot"
        android:layout_width="10dp"
        android:layout_height="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvIdentityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="160dp"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                tools:text="主账号" />

            <TextView
                android:id="@+id/tvRowBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="当前"
                tools:textColor="@color/primary"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            tools:text="哔哩哔哩 (゜-゜)つロ 干杯~" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnCloseTab"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="关闭标签"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:tint="@color/cb_icon" />
</LinearLayout>
