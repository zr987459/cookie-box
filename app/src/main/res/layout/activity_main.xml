<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 顶部极简地址栏 -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- 搜索与网址输入容器 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/ivSecurity"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="安全状态"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/etUrl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_or_enter_url"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_variant"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="刷新"
                    android:padding="6dp"
                    android:src="@drawable/ic_refresh" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnTranslate"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="网页翻译"
                android:padding="8dp"
                android:src="@drawable/ic_translate" />

            <ImageButton
                android:id="@+id/btnMoreTools"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="缩放与工具"
                android:padding="8dp"
                android:src="@drawable/ic_zoom_in" />

            <ImageButton
                android:id="@+id/btnSwitchUa"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="切换UA"
                android:padding="8dp"
                android:src="@drawable/ic_desktop" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="清理Cookie"
                android:padding="8dp"
                android:src="@drawable/ic_clear" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/primary"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 中间主体浏览器视窗 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 多标签 WebView 动态容器 -->
        <FrameLayout
            android:id="@+id/layoutWebContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 首页快捷导航卡片 (未载入页面时展示) -->
        <ScrollView
            android:id="@+id/layoutShortcuts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:fillViewport="true"
            android:padding="20dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:src="@drawable/ic_cookie" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="CookieBox"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="轻量 · 安全 · 穿透提取 · 多窗口与凭据库"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="常用平台快捷入口"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 快捷按钮网格 -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupShortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBilibili"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="哔哩哔哩 (B站)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWeibo"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="微博网页版" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGithub"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GitHub" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBaidu"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="百度搜索" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipZhihu"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="知乎" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipV2ex"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="V2EX" />
                </com.google.android.material.chip.ChipGroup>

                <!-- 特性说明小卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="@color/surface_variant"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 核心特性与安全保障"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:text="• 多窗口支持：底部点击窗口图标，随意新建/切换/关闭标签页。\n• 储存库管理：提取的 Cookie 可一键永久存入本地保险库，随时查看导出。\n• 穿透 HttpOnly：利用原生 Android 协议栈读取任意敏感安全 Token。\n• 真实 WebView：过滑块与风控验证码如真人普通上网，零泄漏风险。"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 底部现代化导航操控栏 -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:backgroundTint="@color/surface"
        app:elevation="6dp"
        app:paddingStart="0dp"
        app:paddingEnd="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- 后退 -->
            <ImageButton
                android:id="@+id/btnNavBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="后退"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back" />

            <!-- 前进 -->
            <ImageButton
                android:id="@+id/btnNavForward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="前进"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_forward" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 储存库管理 -->
            <ImageButton
                android:id="@+id/btnNavStorage"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cookie 储存库"
                android:padding="10dp"
                android:src="@drawable/ic_storage" />

            <!-- 多窗口标签切换 (带窗口数量角标) -->
            <FrameLayout
                android:id="@+id/btnNavTabs"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="多窗口"
                    android:src="@drawable/ic_tabs" />

                <TextView
                    android:id="@+id/tvTabBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_search_box"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 核心提取胶囊按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavExtract"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:text="@string/extract_cookies"
                android:textColor="@color/on_primary"
                android:textSize="13sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="21dp"
                app:icon="@drawable/ic_cookie"
                app:iconTint="@color/on_primary" />
        </LinearLayout>
    </com.google.android.material.bottomappbar.BottomAppBar>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
