<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 深色：颜色角色继承 Base（色值由 values-night/colors*.xml 提供），这里只把系统栏图标改为浅色 -->
    <style name="Theme.CookieBox" parent="Base.Theme.CookieBox">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetModalStyle</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
