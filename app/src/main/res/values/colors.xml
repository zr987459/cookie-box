<?xml version="1.0" encoding="utf-8"?>
<!--
  CookieBox 调色板 · 浅色（T-020 高对比度重制）
  风格：Material 3 中性色阶 + 靛蓝强调（Arc Search 式「纸白 + 深墨 + 一抹品牌色」）
  规则：色名一个不改（Kotlin / 布局直接引用）；所有文字组合 ≥ 7:1（WCAG AAA），
       由 scripts/check_contrast.py 门禁校验。改色后请先跑脚本。
-->
<resources>
    <!-- 品牌色：靛蓝 800。既当文字色也当按钮底色，白字对比 10.4:1 -->
    <color name="primary">#3730A3</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#E0E3FF</color>
    <color name="on_primary_container">#1A1660</color>

    <color name="secondary">#3F4555</color>
    <color name="on_secondary">#FFFFFF</color>
    <color name="secondary_container">#E3E6EE</color>
    <color name="on_secondary_container">#141822</color>

    <!-- 中性面：纸白底 → 纯白卡片 → 浅灰输入框，三层靠明度区分，不靠描边堆叠 -->
    <color name="background">#F5F6F9</color>
    <color name="on_background">#0E1117</color>
    <color name="surface">#FFFFFF</color>
    <color name="on_surface">#0E1117</color>
    <color name="surface_variant">#ECEEF3</color>
    <!-- 副文字：深石墨而不是浅灰，白底 10.6:1、浅灰底 9.2:1 -->
    <color name="on_surface_variant">#3A404D</color>

    <!-- 功能色 -->
    <color name="cookie_chip_bg">#E0E3FF</color>
    <color name="cookie_chip_text">#29237F</color>
    <color name="code_bg">#F1F2F6</color>
    <color name="code_text">#161A23</color>
    <color name="divider">#DADDE5</color>
    <color name="success">#04512F</color>
    <color name="danger">#8E0F29</color>
    <color name="search_border">#C9CDD8</color>
</resources>
