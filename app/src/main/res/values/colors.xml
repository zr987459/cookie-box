<?xml version="1.0" encoding="utf-8"?>
<!--
  CookieBox 1.9 · 「Glacier」浅色调色板（Material 3 角色命名）
  规则：所有文字色在其可能出现的任何底色上对比度 ≥ 7:1（WCAG AAA），
  由 scripts/check_contrast.py 在 CI 中校验。深色值见 values-night/colors.xml，色名一一对应。
-->
<resources>
    <!-- 品牌：深靛蓝。作为文字 ≥7.7:1，作为按钮底配白字 9.3:1 -->
    <color name="primary">#1A3AAE</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#DCE3FF</color>
    <color name="on_primary_container">#0A1A5C</color>

    <color name="secondary">#4A5470</color>
    <color name="on_secondary">#FFFFFF</color>
    <color name="secondary_container">#E3E7F2</color>
    <color name="on_secondary_container">#1A2236</color>

    <!-- 面：页面底 → 卡片/弹窗 → 输入区，三级冷灰白 -->
    <color name="background">#F4F6FB</color>
    <color name="on_background">#0E1525</color>
    <color name="surface">#FFFFFF</color>
    <color name="on_surface">#0E1525</color>
    <color name="surface_variant">#EDF0F7</color>
    <!-- 次级文字/提示文字：在最深的面上仍 ≥ 8:1，不再出现“发灰看不清” -->
    <color name="on_surface_variant">#3D4659</color>

    <!-- 功能色 -->
    <color name="cookie_chip_bg">#DCE3FF</color>
    <color name="cookie_chip_text">#0A1A5C</color>
    <color name="code_bg">#EDF0F7</color>
    <color name="code_text">#0E1525</color>
    <color name="divider">#E1E6EF</color>
    <color name="success">#08532D</color>
    <color name="danger">#8C1913</color>
    <color name="search_border">#C9D1E1</color>
</resources>
