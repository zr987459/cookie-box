<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 仅 Android 9 及以下下载文件到「下载」目录时需要 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 下载完成后可直接安装 APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 13+ 显示下载进度通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AI 访问（MCP，ADR-0004）：默认关闭，用户开启后以前台服务常驻 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_cookie"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_cookie"
        android:supportsRtl="true"
        android:theme="@style/Theme.CookieBox"
        android:usesCleartextTraffic="true">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 可作为浏览器打开链接 / 接收分享的网址 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- AI 访问（MCP）设置页 -->
        <activity
            android:name=".mcp.McpSettingsActivity"
            android:exported="false"
            android:label="AI 访问（MCP）" />

        <!-- AI 访问（MCP）站点授权 -->
        <activity
            android:name=".mcp.McpGrantsActivity"
            android:exported="false"
            android:label="站点授权" />

        <!-- AI 访问（MCP）写操作确认：透明窗口上的对话框，不进最近任务 -->
        <activity
            android:name=".mcp.McpConfirmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="com.cookiebox.app.mcpconfirm"
            android:theme="@style/Theme.CookieBox.McpConfirm" />

        <!-- AI 访问（MCP）调用记录 -->
        <activity
            android:name=".mcp.McpCallLogActivity"
            android:exported="false"
            android:label="调用记录" />

        <!-- 本机 MCP 服务：只监听 127.0.0.1（局域网为独立开关），不对其他应用导出 -->
        <service
            android:name=".mcp.McpService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local MCP server for user-authorized AI clients" />
        </service>
    </application>

</manifest>
